{
  "name": "pinkslip",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "shared"
  ],
  "description": "Early-career job discovery, alerts, and application tooling",
  "overrides": {
    "nanoid": "3.3.18",
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "bun run db:migrate && bun --filter @pinkslip/webapp dev",
    "dev:api": "bun run db:migrate && wrangler dev",
    "deploy": "bun run deploy:backend && bun run deploy:web",
    "deploy:backend": "bun run db:migrate:remote && wrangler deploy --keep-vars",
    "deploy:web": "bun --filter @pinkslip/webapp deploy",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check:webapp": "bun scripts/check-webapp-governance.ts",
    "check": "bun run check:webapp && bun run check:worker-types && bunx tsc --noEmit && bun --filter @pinkslip/tokens check && bun --filter @pinkslip/core check && bun --filter @pinkslip/data check && bun --filter @pinkslip/native check && bun --filter @pinkslip/webapp check:worker-types && bun --filter @pinkslip/webapp check:css-modules && bun --filter @pinkslip/webapp check && bun --filter @pinkslip/webapp lint:css && bun run check:e2e",
    "check:worker-types": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false --strict-vars=false --env-file .dev.vars.example --check",
    "worker:types": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false --strict-vars=false --env-file .dev.vars.example",
    "build": "bun --filter @pinkslip/webapp build",
    "check:e2e": "bun --filter @pinkslip/webapp check:e2e",
    "test:e2e": "bun --filter @pinkslip/webapp test:e2e",
    "db:migrate": "wrangler d1 migrations apply pinkslip --local",
    "db:migrate:remote": "wrangler d1 migrations apply pinkslip --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply pinkslip --local",
    "db:seed:demo": "wrangler d1 execute pinkslip --local --file=seeds/demo_jobs.sql",
    "db:seed:demo:remote": "wrangler d1 execute pinkslip --remote --file=seeds/demo_jobs.sql"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.9.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "web-push": "^3.6.7",
    "wrangler": "^4.127.0"
  }
}
