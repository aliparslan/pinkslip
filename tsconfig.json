{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node", "bun"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@worker/*": ["./worker/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "worker-configuration.d.ts",
    "worker/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  // This config targets the Worker/Bun runtime (no DOM lib). These tests import
  // frontend (DOM-using) code, so they're typechecked by the frontend project
  // instead; bun still runs them via `bun test`.
  "exclude": [
    "node_modules",
    "dist",
    "frontend",
    "tests/native-api-client.test.ts",
    "tests/resume-export.test.ts",
    "tests/salary-format.test.ts",
    "tests/location-format.test.ts",
    "tests/job-content.test.ts",
    "tests/resume-import-policy.test.ts",
    "tests/resume-import-ocr.test.ts",
    "tests/resume-import-orchestrator.test.ts"
  ]
}
