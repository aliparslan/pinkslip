# Security headers for the static app shell (served by Cloudflare Workers
# Assets, which bypasses the Worker). SvelteKit emits the remaining CSP
# as a meta policy with build-specific hashes for its bootstrap script.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# Personal app routes are not public search landing pages.
/feed
  X-Robots-Tag: noindex, follow

/you/*
  X-Robots-Tag: noindex, follow

/library/*
  X-Robots-Tag: noindex, follow

/admin/*
  X-Robots-Tag: noindex, nofollow

/jobs/*
  X-Robots-Tag: noindex, follow

/resume/*
  X-Robots-Tag: noindex, follow

/you
  X-Robots-Tag: noindex, follow

/library
  X-Robots-Tag: noindex, follow

/admin
  X-Robots-Tag: noindex, nofollow

/tailor/*
  X-Robots-Tag: noindex, follow

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/_app/version.json
  Cache-Control: no-cache, no-store, must-revalidate
