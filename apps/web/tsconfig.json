{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "$app/types"
    ]
  },
  "include": [
    "src",
    "*",
    "../../packages/client/src",
    "../../shared"
  ],
  "exclude": [
    "src/service-worker",
    "e2e"
  ]
}
