{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinkslip-web",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Production domains remain on the Svelte Worker until chunk 3.4.
  "services": [{ "binding": "API", "service": "pinkslip" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
