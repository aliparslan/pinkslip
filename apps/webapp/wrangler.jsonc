{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinkslip-web",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Both hostnames moved here from the API Worker in chunk 3.4. API paths are
  // forwarded to it through the `API` binding (src/server/routing.ts).
  "routes": [
    { "pattern": "pinkslip.work", "custom_domain": true },
    { "pattern": "pinkslip.alip.dev", "custom_domain": true }
  ],
  "services": [{ "binding": "API", "service": "pinkslip" }],
  // "on" lets search engines index the public pages (src/server/routing.ts).
  "vars": { "SEARCH_INDEXING": "on" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
