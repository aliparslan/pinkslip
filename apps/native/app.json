{
  "expo": {
    "name": "Pinkslip",
    "slug": "pinkslip",
    "scheme": "pinkslip",
    "version": "1.3.8",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.alip.pinkslip",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:pinkslip.work",
        "applinks:pinkslip.alip.dev",
        "webcredentials:pinkslip.work"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "appleTeamId": "KV876H8952",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-router",
      "expo-asset",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7441d5b-2424-4a4a-bcbd-be5c26f36588"
      }
    },
    "owner": "lipster",
    "runtimeVersion": "1.3.8",
    "updates": {
      "url": "https://u.expo.dev/a7441d5b-2424-4a4a-bcbd-be5c26f36588",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
