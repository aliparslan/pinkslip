{
  "expo": {
    "name": "Pinkslip",
    "slug": "pinkslip",
    "scheme": "pinkslip",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.alip.pinkslip",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:pinkslip.work",
        "applinks:pinkslip.alip.dev"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "appleTeamId": "KV876H8952"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
